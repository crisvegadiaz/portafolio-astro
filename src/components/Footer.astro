---
const { footer } = Astro.props;
const { title, ...languages } = footer.languageOptions;
const langKeys = Object.keys(languages);
---

<footer>
  <p>{footer.copyright}</p>
  <label for="language" class="sr-only">{title}</label>
  <select id="language" name="language">
    {
      langKeys.map((key) => (
        <option value={key} selected={key === footer.selectedLanguage}>
          {languages[key]}
        </option>
      ))
    }
  </select>
</footer>

<script is:inline src="/js/footer.js"></script>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
  footer {
    grid-area: footer;
    display: flex;
    align-items: center;
    background-color: var(--color-dark-blue);
    position: sticky;
    bottom: 0;
    z-index: 99;
  }
  p {
    color: var(--color-white);
    font-size: 1rem;
    font-weight: 600;
    text-align: center;
    font-family: "Roboto", sans-serif;
    width: 100%;
  }

  select {
    background-color: var(--color-purple);
    color: var(--color-white);
    border: none;
    font-size: 0.9rem;
    font-weight: 600;
    font-family: "Roboto", sans-serif;
    cursor: pointer;
    margin-right: 1rem;
  }

  @media (width < 1024px) {
    footer {
      overflow: hidden;
    }
    p {
      padding: 0 1rem;
      font-weight: 700;
    }
    select {
      box-sizing: border-box;
      font-weight: 700;
      padding: 1rem;
      margin-right: 0;
    }
  }

  @media (width < 768px) {
    p {
      font-size: 0.8rem;
    }
    select {
      font-size: 0.8rem;
      margin-right: 0;
    }
  }
</style>
