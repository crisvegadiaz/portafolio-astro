---
import Explore from "./Explore.astro";
import Contact from "./Contact.astro";
import Search from "./Search.astro";

interface SidebarData {
  explore: any;
  contact: any;
  search: any;
}

interface Props {
  sidebar: SidebarData;
}

const { sidebar } = Astro.props;
const { explore, contact, search } = sidebar;
---

<section class="secondary-sidebar">
  <Explore explore={explore} />
  <Contact contact={contact} />
  <Search search={search} />
</section>

<style>
  section {
    grid-area: submenu;
    background-color: var(--color-deep-blue);
  }

  .secondary-sidebar {
    display: none;
  }

  .secondary-active {
    display: block;
  }

  @media (width < 768px) {
    .secondary-sidebar.secondary-active {
      position: fixed;
      top: 0;
      right: 0;
      bottom: 3rem;
      left: 3rem;
      z-index: 10;
      overflow-y: auto;
      overscroll-behavior: contain;
      box-shadow: 0 0 1rem rgba(0, 0, 0, 0.35);
    }
  }
</style>
